rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Hàm kiểm tra phân quyền cốt lõi ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOfficer() {
      return isSignedIn() && request.auth.token.role == "OFFICER";
    }

    function isActiveUserDoc(uid) {
      let userDoc = get(/databases/$(database)/documents/users/$(uid));
      return userDoc != null && userDoc.data.status == "ACTIVE";
    }

    function isAccountOwner(accountId) {
      let accDoc = get(/databases/$(database)/documents/accounts/$(accountId));
      return accDoc != null && accDoc.data.ownerUid == request.auth.uid;
    }

    // 1. users/{uid} & subcollection beneficiaries/{id}
    match /users/{uid} {
      allow read: if isOwner(uid) || isOfficer();
      // Khách hàng đang ACTIVE chỉ được phép tự cập nhật SĐT, địa chỉ, ảnh đại diện đúng kiểu & giới hạn độ dài (cấm sửa role, status, ekyc, CCCD)
      allow update: if isOwner(uid)
        && resource != null
        && resource.data.status == "ACTIVE"
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(["phone", "address", "avatarUrl", "updatedAt"])
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 8
        && request.resource.data.phone.size() <= 20
        && request.resource.data.address is string
        && request.resource.data.address.size() >= 1
        && request.resource.data.address.size() <= 500
        && request.resource.data.avatarUrl is string
        && request.resource.data.avatarUrl.size() <= 2048
        && request.resource.data.updatedAt is timestamp;
      allow create, delete: if false;

      match /beneficiaries/{beneficiaryId} {
        allow read: if isOwner(uid) || isOfficer();
        allow create, update: if isOwner(uid)
          && isActiveUserDoc(uid)
          && request.resource.data.keys().hasOnly(["name", "accountNumber", "bankCode", "alias"])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 120
          && request.resource.data.accountNumber is string
          && request.resource.data.accountNumber.size() >= 4
          && request.resource.data.accountNumber.size() <= 34
          && request.resource.data.bankCode is string
          && request.resource.data.bankCode.size() <= 20
          && request.resource.data.alias is string
          && request.resource.data.alias.size() <= 80;
        allow delete: if isOwner(uid)
          && isActiveUserDoc(uid);
      }

      // Hộp thư thông báo biến động số dư, bảo mật, tiết kiệm & eKYC (chỉ Admin SDK tạo mới)
      match /notifications/{notifId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && isActiveUserDoc(uid)
          && resource != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }
    }

    // Kho lưu trữ mã băm PIN giao dịch nội bộ — tuyệt đối cấm Client đọc/ghi
    match /user_secrets/{uid} {
      allow read, write: if false;
    }

    // 2. ekyc_images/{uid} — Chỉ Server ghi; chính chủ và Officer đọc
    match /ekyc_images/{uid} {
      allow read: if isOwner(uid) || isOfficer();
      allow write: if false;
    }

    // 3. accounts/{accountId} & subcollection ledger/{entryId}
    match /accounts/{accountId} {
      allow read: if (isSignedIn() && resource != null && resource.data.ownerUid == request.auth.uid) || isOfficer();
      allow write: if false;

      match /ledger/{entryId} {
        allow read: if (isSignedIn() && isAccountOwner(accountId)) || isOfficer();
        allow write: if false;
      }
    }

    // 4. transactions/{txId} — Chỉ Server ghi trong ACID Transaction; người gửi, người nhận nội bộ và Officer được đọc biên lai
    match /transactions/{txId} {
      allow read: if isOfficer()
        || (isSignedIn() && resource != null && (
             resource.data.initiatedBy == request.auth.uid
             || (resource.data.get("toAccountId", "") is string
                 && resource.data.get("toAccountId", "").size() > 0
                 && isAccountOwner(resource.data.toAccountId))
           ));
      allow write: if false;
    }

    // 5. transaction_drafts/{draftId} — Tuyệt đối chỉ Server đọc/ghi (chứa otpHash & stripeIntentId)
    match /transaction_drafts/{draftId} {
      allow read, write: if false;
    }

    // 6. face_checks/{draftId} — Chỉ Server ghi; Officer đọc để hậu kiểm
    match /face_checks/{draftId} {
      allow read: if isOfficer();
      allow write: if false;
    }

    // 7. interest_rates/{rateId} — Người dùng đăng nhập được đọc; chỉ Server (qua API Officer) được ghi
    match /interest_rates/{rateId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 8. banks/{bankCode} — Danh mục ngân hàng liên kết
    match /banks/{bankCode} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 9. branches/{branchId} — Danh sách chi nhánh & ATM NovaBank
    match /branches/{branchId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 10. utility_bills/{billId} — Tra cứu hóa đơn Điện/Nước; cập nhật PAID bắt buộc qua Server Transaction
    match /utility_bills/{billId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 11. service_catalog/{itemId} — Danh mục vé máy bay, xem phim, khách sạn, sản phẩm TMĐT
    match /service_catalog/{itemId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 12. orders/{orderId} — Đơn hàng dịch vụ của khách hàng
    match /orders/{orderId} {
      allow read: if (isSignedIn() && resource != null && resource.data.uid == request.auth.uid) || isOfficer();
      allow write: if false;
    }

    // 13. chat_sessions/{uid}/messages/{msgId} — Lịch sử AI Chatbot (ghi qua POST /ai/chat trên Server)
    match /chat_sessions/{uid}/messages/{msgId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // 14. audit_logs/{logId} — Nhật ký kiểm toán thao tác của Officer (bất biến phía Client)
    match /audit_logs/{logId} {
      allow read: if isOfficer();
      allow write: if false;
    }

    // Khóa mặc định toàn bộ đường dẫn ngoài 14 collections được phép
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
