# Cấu hình môi trường mẫu cho NovaPay Backend Server (Tuyệt đối không commit file .env thật)
PORT=3000

# ============================================================================
# 1. FIREBASE ADMIN SDK (Copy 3 trường từ file novapay-xxxx-firebase-adminsdk.json)
# ============================================================================
FIREBASE_PROJECT_ID=novapay-71326
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@novapay-71326.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# (Tùy chọn thay thế: Chuỗi JSON 1 dòng hoặc đường dẫn file GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT_JSON=

# ============================================================================
# 2. DỊCH VỤ GỬI OTP EMAIL QUA HTTPS (Brevo API)
# Lưu ý: BREVO_SENDER_EMAIL bắt buộc phải là địa chỉ đã xác minh (Verified Sender)
# trên Brevo Dashboard (ví dụ Gmail đã xác minh của nhóm). Giá trị mặc định
# no-reply@novapay.vn có thể bị Brevo từ chối nếu miền chưa xác minh.
# ============================================================================
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@gmail.com
BREVO_SENDER_NAME=NovaPay Banking

# ============================================================================
# 3. CỔNG THANH TOÁN STRIPE (Test Mode Secret Key: sk_test_...)
# ============================================================================
STRIPE_SECRET_KEY=

# ============================================================================
# 4. GOOGLE GEMINI API (Dùng cho FaceCheck Multimodal & AI Chatbot)
# ============================================================================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# 5. EMAIL GMAIL THẬT CHO 4 TÀI KHOẢN KHỞI TẠO (1 OFFICER + 3 CUSTOMER)
# Bắt buộc cấu hình cục bộ trong server/.env trước khi chạy `npm run seed`
# ============================================================================
SEED_OFFICER_EMAIL=
SEED_MEMBER_1_EMAIL=
SEED_MEMBER_2_EMAIL=
SEED_MEMBER_3_EMAIL=
