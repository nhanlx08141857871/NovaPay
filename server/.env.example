# Cấu hình môi trường mẫu cho NovaPay Backend Server (Tuyệt đối không commit file .env thật)
PORT=3000

# Chuỗi JSON một dòng của Firebase Admin Service Account (hoặc dùng GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Dịch vụ gửi OTP Email qua HTTPS (Brevo API)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@novapay.vn
BREVO_SENDER_NAME=NovaPay Banking

# Cổng thanh toán Stripe (Test Mode Secret Key: sk_test_...)
STRIPE_SECRET_KEY=

# Google Gemini API (Dùng cho FaceCheck Multimodal & AI Chatbot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
