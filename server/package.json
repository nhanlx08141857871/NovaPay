{
  "name": "novapay-server",
  "version": "1.0.0",
  "description": "NovaPay Hybrid Cloud Backend (Node.js + TypeScript + Express + Firebase Admin)",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/runTests.ts",
    "seed": "tsx scripts/seed.ts",
    "cleanup:drafts": "tsx scripts/cleanupDrafts.ts",
    "deploy:rules": "tsx scripts/deployRules.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.0.0",
    "stripe": "^17.7.0",
    "typescript": "^5.7.3"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
