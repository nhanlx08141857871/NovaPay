<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ========================================================== -->
    <!-- Reusable Material 3 Component Styles (Quiet Instrument)    -->
    <!-- ========================================================== -->

    <!-- Primary CTA Button (Deep Navy #0F172A, 12dp radius, 0dp shadow) -->
    <style name="Widget.NovaPay.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/np_button_height</item>
        <item name="cornerRadius">@dimen/np_control_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Accent CTA Button (Emerald #059669 for confirmations / approvals) -->
    <style name="Widget.NovaPay.Button.Accent" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/np_button_height</item>
        <item name="cornerRadius">@dimen/np_control_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">@color/np_accent_emerald</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Outlined Secondary Button (1dp crisp border, 12dp radius) -->
    <style name="Widget.NovaPay.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/np_button_height</item>
        <item name="cornerRadius">@dimen/np_control_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/np_border_control</item>
        <item name="strokeWidth">@dimen/np_border_hairline</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Destructive Outlined Button (for Reject / Lock actions) -->
    <style name="Widget.NovaPay.Button.Outlined.Danger" parent="Widget.NovaPay.Button.Outlined">
        <item name="strokeColor">@color/np_badge_locked_stroke</item>
        <item name="android:textColor">@color/novapay_expense_negative</item>
        <item name="iconTint">@color/novapay_expense_negative</item>
    </style>

    <!-- Tonal Compact Button -->
    <style name="Widget.NovaPay.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/np_button_height_compact</item>
        <item name="cornerRadius">@dimen/np_control_radius</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">?attr/colorPrimaryContainer</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="iconTint">?attr/colorOnPrimaryContainer</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Back Header Button -->
    <style name="Widget.NovaPay.Button.Back" parent="Widget.Material3.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="cornerRadius">@dimen/np_control_radius</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="icon">@drawable/ic_modc_back</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconTint">?attr/colorOnBackground</item>
        <item name="android:textColor">?attr/colorOnBackground</item>
    </style>

    <!-- Quick Action Grid Tile Button (Icon Top, Crisp Border, Pure Surface) -->
    <style name="Widget.NovaPay.Button.QuickAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/np_control_radius</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="strokeColor">@color/np_border_hairline</item>
        <item name="strokeWidth">@dimen/np_border_hairline</item>
        <item name="iconGravity">top</item>
        <item name="iconSize">22dp</item>
        <item name="iconPadding">6dp</item>
        <item name="iconTint">@color/np_accent_emerald</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <!-- Secondary Explore Action Tile (Muted Navy Icon) -->
    <style name="Widget.NovaPay.Button.QuickAction.Secondary" parent="Widget.NovaPay.Button.QuickAction">
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- Quiet Instrument Surface Cards: Pure White + 1dp #E2E8F0 Hairline, Zero Heavy Shadow -->
    <style name="Widget.NovaPay.Card.Elevated" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/np_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">@dimen/np_border_hairline</item>
        <item name="strokeColor">@color/np_border_hairline</item>
    </style>

    <style name="Widget.NovaPay.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/np_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeWidth">@dimen/np_border_hairline</item>
        <item name="strokeColor">@color/np_border_hairline</item>
    </style>

    <!-- Modern Outlined TextInputLayout (12dp radius, Emerald focus ring) -->
    <style name="Widget.NovaPay.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/np_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/np_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/np_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/np_control_radius</item>
        <item name="boxStrokeColor">@color/selector_np_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Modern Exposed Dropdown Menu (12dp radius, Emerald focus ring) -->
    <style name="Widget.NovaPay.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">@dimen/np_control_radius</item>
        <item name="boxCornerRadiusTopEnd">@dimen/np_control_radius</item>
        <item name="boxCornerRadiusBottomStart">@dimen/np_control_radius</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/np_control_radius</item>
        <item name="boxStrokeColor">@color/selector_np_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">1.5dp</item>
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="hintTextColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Semantic Pill Status Badge -->
    <style name="Widget.NovaPay.StatusBadge" parent="android:Widget.TextView">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/bg_np_badge_neutral</item>
    </style>

    <!-- Customer 4-Tab BottomNavigationView -->
    <style name="Widget.NovaPay.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="elevation">0dp</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.NovaPay.BottomNavigationView.ActiveIndicator</item>
        <item name="itemIconTint">@color/selector_np_bottom_nav</item>
        <item name="itemTextColor">@color/selector_np_bottom_nav</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="Widget.NovaPay.BottomNavigationView.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/np_accent_emerald_soft</item>
    </style>

    <!-- Brand Logo Rounded Corner Overlays (16dp Hero / 12dp Header & Receipt / 6dp Avatar) -->
    <style name="ShapeAppearance.NovaPay.Logo16" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.NovaPay.Logo12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.NovaPay.LogoSmall" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">6dp</item>
    </style>
</resources>
