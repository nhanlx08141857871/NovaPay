<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_money"
    app:startDestination="@id/transferFragment">

    <!-- 1. Chuyển tiền nội bộ NovaPay & Liên ngân hàng 24/7 -->
    <fragment
        android:id="@+id/transferFragment"
        android:name="com.novabank.novapay.presentation.customer.transfer.TransferFragment"
        android:label="@string/money_transfer_title"
        tools:layout="@layout/fragment_transfer">

        <argument
            android:name="type"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="accountId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="accountNumber"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="bankCode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="recipientName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="amount"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="note"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />

        <deepLink app:uri="novapay://transfer" />
        <deepLink app:uri="novapay://transfer?type={type}&amp;accountId={accountId}" />
        <deepLink app:uri="novapay://transfer?accountNumber={accountNumber}" />
        <deepLink app:uri="novapay://transfer?accountNumber={accountNumber}&amp;bankCode={bankCode}&amp;recipientName={recipientName}&amp;amount={amount}&amp;note={note}" />
    </fragment>

    <!-- 2. Quét mã QR nhận tiền (CameraX + ML Kit Barcode) -->
    <fragment
        android:id="@+id/qrScannerFragment"
        android:name="com.novabank.novapay.presentation.customer.transfer.QrScannerFragment"
        android:label="@string/money_qr_title"
        tools:layout="@layout/fragment_qr_scanner" />

    <!-- 3. Biên lai giao dịch điện tử (E-Receipt PNG Share) -->
    <fragment
        android:id="@+id/receiptFragment"
        android:name="com.novabank.novapay.presentation.customer.transfer.ReceiptFragment"
        android:label="@string/money_receipt_title"
        tools:layout="@layout/fragment_receipt">
        <argument
            android:name="txId"
            app:argType="string" />
    </fragment>

    <!-- 4. Nạp tiền Stripe (GATEWAY), Rút tiền (WITHDRAW) & Trả nợ vay (MORTGAGE_PAYMENT) -->
    <fragment
        android:id="@+id/depositWithdrawFragment"
        android:name="com.novabank.novapay.presentation.customer.payment.DepositWithdrawFragment"
        android:label="@string/money_dw_title"
        tools:layout="@layout/fragment_deposit_withdraw">
        <argument
            android:name="mode"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="accountId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>

    <!-- 5. Thanh toán hóa đơn Điện / Nước -->
    <fragment
        android:id="@+id/utilityBillFragment"
        android:name="com.novabank.novapay.presentation.customer.utility.UtilityBillFragment"
        android:label="@string/money_bills_title"
        tools:layout="@layout/fragment_utility_bill">
        <deepLink app:uri="novapay://bills" />
    </fragment>

    <!-- 6. Nạp tiền điện thoại di động -->
    <fragment
        android:id="@+id/phoneTopupFragment"
        android:name="com.novabank.novapay.presentation.customer.utility.PhoneTopupFragment"
        android:label="@string/money_topup_title"
        tools:layout="@layout/fragment_phone_topup">
        <deepLink app:uri="novapay://topup" />
    </fragment>

    <!-- 7. Đặt vé máy bay, xem phim, khách sạn & mua sắm TMĐT -->
    <fragment
        android:id="@+id/serviceBookingFragment"
        android:name="com.novabank.novapay.presentation.customer.utility.ServiceBookingFragment"
        android:label="@string/money_services_title"
        tools:layout="@layout/fragment_service_booking">
        <deepLink app:uri="novapay://services" />
    </fragment>

</navigation>
