<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <ScrollView
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/np_screen_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBack"
                    style="@style/Widget.NovaPay.Button.Back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/core_action_back" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="@string/core_open_saving_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnBackground"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.NovaPay.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSourceAccount"
                        style="@style/Widget.NovaPay.TextInputLayout.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/core_open_saving_source_label">

                        <AutoCompleteTextView
                            android:id="@+id/actvSourceAccount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPrincipal"
                        style="@style/Widget.NovaPay.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/core_open_saving_amount_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPrincipal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:inputType="number" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">

                        <com.google.android.material.chip.ChipGroup
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAmount1m"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/core_open_saving_chip_1m" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAmount5m"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/core_open_saving_chip_5m" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAmount10m"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/core_open_saving_chip_10m" />

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipAmount50m"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:text="@string/core_open_saving_chip_50m" />
                        </com.google.android.material.chip.ChipGroup>
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.NovaPay.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_open_saving_term_section"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:selectionRequired="true"
                        app:singleSelection="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.NovaPay.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="@color/np_accent_emerald_soft"
                app:contentPadding="16dp"
                app:strokeColor="@color/np_badge_verified_stroke">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_open_saving_preview_title"
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textColor="@color/np_accent_emerald_ink"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/core_open_saving_preview_rate"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/np_accent_emerald_ink" />

                        <TextView
                            android:id="@+id/tvPreviewRate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/novapay_income_positive"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/core_open_saving_preview_monthly"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/np_accent_emerald_ink" />

                        <TextView
                            android:id="@+id/tvPreviewMonthlyInterest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/novapay_income_positive"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/core_open_saving_preview_total_interest"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/np_accent_emerald_ink" />

                        <TextView
                            android:id="@+id/tvPreviewTotalInterest"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/novapay_income_positive"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/core_open_saving_preview_maturity_date"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="@color/np_accent_emerald_ink" />

                        <TextView
                            android:id="@+id/tvPreviewMaturityDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/np_accent_emerald_ink"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/np_badge_verified_stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/core_open_saving_preview_total_payout"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="@color/np_accent_emerald_ink"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewTotalPayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/novapay_income_positive"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPinVerification"
                style="@style/Widget.NovaPay.Card.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:contentPadding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/core_open_saving_pin_note"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilPin"
                        style="@style/Widget.NovaPay.TextInputLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/core_open_saving_pin_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etPin"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:inputType="numberPassword"
                            android:maxLength="6" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitOpenSaving"
                style="@style/Widget.NovaPay.Button.Accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:text="@string/core_open_saving_submit" />
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/stateLoading"
        layout="@layout/view_loading_state" />

    <include
        android:id="@+id/stateEmpty"
        layout="@layout/view_empty_state" />

    <include
        android:id="@+id/stateError"
        layout="@layout/view_error_state" />
</FrameLayout>
