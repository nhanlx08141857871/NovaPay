<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarChatbot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:navigationContentDescription="@string/officer_action_back"
        app:navigationIcon="@drawable/ic_modc_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/chatbot_title"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:titleTextColor="?attr/colorOnSurface" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/np_border_hairline" />

    <FrameLayout
        android:id="@+id/layoutBodyContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/contentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp" />

        <include
            android:id="@+id/stateLoading"
            layout="@layout/view_loading_state" />

        <include
            android:id="@+id/stateEmpty"
            layout="@layout/view_empty_state" />

        <include
            android:id="@+id/stateError"
            layout="@layout/view_error_state" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/np_border_hairline" />

    <HorizontalScrollView
        android:id="@+id/scrollChatbotSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:paddingHorizontal="14dp"
        android:paddingTop="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupSuggestions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestBalance"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chatbot_suggestion_balance" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestBills"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chatbot_suggestion_bills" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSuggestBranches"
                style="@style/Widget.Material3.Chip.Suggestion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chatbot_suggestion_branches" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressSendingChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/np_accent_emerald"
        app:trackColor="@color/np_border_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilChatInput"
            style="@style/Widget.NovaPay.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/chatbot_input_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etChatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendChat"
            style="@style/Widget.NovaPay.Button.Accent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="52dp"
            android:text="@string/chatbot_send_action"
            app:icon="@drawable/ic_modc_send" />
    </LinearLayout>

</LinearLayout>
