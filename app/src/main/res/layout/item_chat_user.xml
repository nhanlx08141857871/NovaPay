<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="vertical"
    android:paddingVertical="5dp">

    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.NovaPay.Card.Outlined"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        app:cardBackgroundColor="@color/np_hero_navy_bg"
        app:contentPadding="14dp"
        app:strokeColor="@color/np_hero_navy_stroke">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvUserMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:lineSpacingExtra="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/np_hero_navy_text" />

            <TextView
                android:id="@+id/tvUserMessageTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:fontFeatureSettings="tnum"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/np_hero_navy_muted" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
