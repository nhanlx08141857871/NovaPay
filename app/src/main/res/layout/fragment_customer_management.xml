<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarCustomers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:menu="@menu/menu_officer_refresh"
            app:navigationContentDescription="@string/officer_action_back"
            app:navigationIcon="@drawable/ic_modc_back"
            app:title="@string/officer_customers_title"
            app:titleTextColor="?attr/colorOnSurface" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilSearchCustomer"
            style="@style/Widget.NovaPay.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/officer_customers_search_hint"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_modc_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearchCustomer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressCustomerAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/layoutBodyContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/contentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="88dp" />

            <include
                android:id="@+id/stateLoading"
                layout="@layout/view_loading_state" />

            <include
                android:id="@+id/stateEmpty"
                layout="@layout/view_empty_state" />

            <include
                android:id="@+id/stateError"
                layout="@layout/view_error_state" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateCustomer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:contentDescription="@string/officer_create_customer_title"
        app:srcCompat="@drawable/ic_modc_add" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
